# Copy to .env; only the backend reads this file. Never commit .env.
OPENAI_BASE_URL=https://llmapi.paratera.com/v1
OPENAI_MODEL=GLM-4.5-Flash
OPENAI_API_KEY=
RAG_TIMEOUT=60
RAG_MAX_TOKENS=2400
# Optional model-specific parameter; use default to omit it for other platforms.
RAG_THINKING=disabled
RAG_EMBED_PATH=models/bge-small-zh-v1.5
# api or local (local needs an explicitly downloaded causal language model)
RAG_GENERATOR=api
RAG_LOCAL_MODEL=models/Qwen2.5-0.5B-Instruct
